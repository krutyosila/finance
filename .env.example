# Bu dosya örnektir; gerçek ortam dosyanız Git'e eklenmez.
# Yerel mod: FINANCE_PUBLIC_URL tanımlanmaz. Node --env-file ile veya shell üzerinden yükleyin.
FINANCE_PORT=4317
FINANCE_TIMEZONE=Europe/Istanbul
FINANCE_DB=./data/finance.sqlite
FINANCE_AUTH_DB=./data/auth.sqlite
# FINANCE_PUBLIC_URL=https://finance.example.com

# Sunucu /etc/finance/finance.env değerleri:
# FINANCE_DB=/var/lib/finance/data/finance.sqlite
# FINANCE_AUTH_DB=/var/lib/finance/data/auth.sqlite
# FINANCE_PUBLIC_URL=https://finance.example.com
# FINANCE_NODE_BIN=/opt/finance/runtime/node/bin/node
# Parola bu dosyaya yazılmaz; admin --password-file ile tek seferlik sağlanır.
